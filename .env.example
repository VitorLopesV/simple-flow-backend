# URL e chaves do projeto Supabase (Project Settings > API)
SUPABASE_URL=https://euyezrijzrptczujckyq.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Porta do servidor local (batendo com VITE_API_URL=http://localhost:3000/api do frontend)
PORT=3000

NODE_ENV=development

# Segredo do cron que mantém o projeto Supabase ativo (GET /api/keepalive). Gere um valor longo e aleatório;
# na Vercel, a mesma variável é enviada como Bearer pelo Vercel Cron.
CRON_SECRET=

# Origens permitidas por CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5180
